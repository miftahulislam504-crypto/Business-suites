# Vercel -> Project -> Settings -> Environment Variables-এ এগুলো বসান (মান নিজের)
# নাম মিলিয়ে নিন; NEXT_PUBLIC_ দিয়ে শুরু হওয়া মান ব্রাউজারে যায়, তাই গোপন কিছু সেখানে রাখবেন না।

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI (শুধু সার্ভারে — কখনও NEXT_PUBLIC_ দেবেন না) ---
# ফ্রি: console.groq.com থেকে API key নিন (কার্ড লাগে না)
GROQ_API_KEY=
# ঐচ্ছিক: মডেল বদলাতে চাইলে (ডিফল্ট openai/gpt-oss-120b)
# GROQ_MODEL=
# ঐচ্ছিক: Groq-র ফ্রি সীমায় প্রতি অনুরোধে সর্বোচ্চ উত্তরের টোকেন (ডিফল্ট 1500)
# GROQ_MAX_OUTPUT=

# ঐচ্ছিক, পরে চাইলে: Claude (পেইড)। দুটো key থাকলে AI_PROVIDER=groq অথবা anthropic লিখে বেছে নিন
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AI_PROVIDER=
